{
    "1": "جَزَآءً",
    "2": "المَلٰئِكَةُ",
    "3": "اِنَّٱ أَعْطَيْنَا",
    "4": "اِلَيْنَآ اِيَّابَهُمْ",
    "5": "خَيْرًا يَرَهُ",
    "6": "شَرًّا يَرَهُ",
    "7": "مِيقَاتًا تايَّوْمَ",
    "8": "فَمَنْ يَعْمَلْ",
    "9": "يُؤْمِئِذٍ يَصْدُّرُ النَّاسُ",
    "10": "مِنْ رَبِّكَ",
    "11": "رَسُولٌ مِنَ اللَّهِ",
    "12": "صُحُفًا مُطَهَّرَةً",
    "13": "صَفَّا لَا يَتَكَلَّمُونَ",
    "14": "قُلُوبٌ يُؤْمَئِذٍ وَّاجِفَةٌ أَبْصَارُهَا",
    "15": "سِرَاجًاوَّهَّاجًا وَّاَنْزَلْنَا",
    "16": "اَكْلًالَّمًّا وَتُحِبُّونَ الْمَالَ حُبًّا جمًّا",
    "17": "غُثَآءً أَحْوٰى",
    "18": "مُعْتَدٍ أَثِيمٍ اِذَا تُتْلىٰ",
    "19": "نَارًا حَامِيَةً تَسْقَىٰ مِنْ عَيْنٍ آنِيَةٍ",
    "20": "مَنْ بَخِلَ",
    "21": "ليُنْبَذَنَّ",
    "22": "مِنْ بَعْدِ",
    "23": "مِنْ بَيْنِ الصُّلْبِ",
    "24": "لَنَسْفَعًا بِالنَّاصِيَةِ",
    "25": "بِذَنبِهِم",
    "26": "مُطَهَّرَةٍ بِأَيْدِى سَفَرَةٍ كِرَامٍ بَرَرَةٍ",
    "27": "هُمْ فِيهَا",
    "28":  "لَكُمْ دِينُكُمْ وَلِيَ دِينِ",
    "29": "اِنَّ رَبَّهُم بِهِم",
    "30":  "تَرْمِيْهِمْ بِحِجَارَةٍ",
    "31": "لَهُمْ مَا يَشَآءُوْنَ",
    "32":  "مِمَّ",
    "33":  "اَللّٰهُمَّ"

