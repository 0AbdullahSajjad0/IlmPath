{
  "expo": {
    "name": "IlmPath",
    "slug": "IlmPath",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/images/IlmPath_Splash.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./app/assets/images/IlmPath_Splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E0B15E"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./app/assets/images/favicon.png"
    },
    "entryPoint": "./App.js",
    "assetBundlePatterns": [
      "app/assets/data/*"
    ]
  }
}
